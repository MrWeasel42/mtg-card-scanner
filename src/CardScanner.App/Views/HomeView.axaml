<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CardScanner.App.ViewModels"
             x:Class="CardScanner.App.Views.HomeView">
  <UserControl.Styles>
    <Style Selector="Button.tile">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="Padding" Value="18,16" />
      <Setter Property="Margin" Value="0,0,14,14" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelEdgeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource TealBrush}" />
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    </Style>
    <Style Selector="Button.folder">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="28,22" MaxWidth="1100" HorizontalAlignment="Stretch" Spacing="18">
      <TextBlock Classes="h1" Text="Home" />

      <UniformGrid Columns="4" Margin="0,0,-14,0">
        <Button Classes="tile" Command="{Binding StartSessionCommand}">
          <StackPanel Spacing="6">
            <TextBlock Text="▶" FontSize="26" Classes="teal" />
            <TextBlock Text="Start a session" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="Name it, pick Catalog or Sort and the bin rules. The phone and the machine join it." />
          </StackPanel>
        </Button>
        <Button Classes="tile" Command="{Binding ContinueSessionCommand}" IsEnabled="{Binding SessionRunning}">
          <StackPanel Spacing="6">
            <TextBlock Text="⏯" FontSize="26" Classes="teal" />
            <TextBlock Text="Continue session" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding ContinueText}" />
          </StackPanel>
        </Button>
        <Button Classes="tile" Command="{Binding OpenScanPageCommand}">
          <StackPanel Spacing="6">
            <TextBlock Text="🃏" FontSize="26" />
            <TextBlock Text="Scan page" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="Identify photos (drag them in), review and verify cards, compare printings." />
          </StackPanel>
        </Button>
        <Button Classes="tile" Command="{Binding OpenSettingsCommand}">
          <StackPanel Spacing="6">
            <TextBlock Text="⚙" FontSize="26" Classes="teal" />
            <TextBlock Text="Settings" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="Theme, compare view, finish, phone link and the default bin setup." />
          </StackPanel>
        </Button>
      </UniformGrid>

      <Grid ColumnDefinitions="2*,18,*">
        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="Recent sessions" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Classes="muted" FontSize="12" Text="No sessions yet." IsVisible="{Binding !HasRecent}" />
            <ItemsControl ItemsSource="{Binding Recent}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <StackPanel Spacing="1">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StateText}" FontSize="12" Foreground="{DynamicResource WarnTextBrush}" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Classes="muted" FontSize="12">
                        <Run Text="{Binding When}" /><Run Text="  ·  " /><Run Text="{Binding Summary}" />
                      </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1" Content="📁 Open" FontSize="12" VerticalAlignment="Center"
                            Command="{Binding $parent[ItemsControl].DataContext.OpenRecentCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Classes="card" VerticalAlignment="Top">
          <StackPanel Spacing="4">
            <TextBlock Text="Folders" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
            <Button Classes="folder" Content="📂 Data folder (everything)" Command="{Binding OpenDataFolderCommand}"
                    ToolTip.Tip="{Binding DataFolderText}" />
            <Button Classes="folder" Content="📁 Sessions" Command="{Binding OpenSessionsFolderCommand}"
                    ToolTip.Tip="One folder per session: summary, CSVs and the card crops" />
            <Button Classes="folder" Content="⇩ Exports" Command="{Binding OpenExportsFolderCommand}"
                    ToolTip.Tip="CSVs exported outside a session" />
            <Button Classes="folder" Content="📄 Logs" Command="{Binding OpenLogsFolderCommand}"
                    ToolTip.Tip="Results log (every card, how it was read, its bin), errors.log, crops from outside sessions" />
            <Button Classes="folder" Content="📱 Phone photos" Command="{Binding OpenPhonePhotosFolderCommand}"
                    ToolTip.Tip="Photos the phone or the machine sent, one folder per day" />
            <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" Text="{Binding DataFolderText}" />
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
