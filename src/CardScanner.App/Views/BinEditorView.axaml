<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CardScanner.App.ViewModels"
             x:Class="CardScanner.App.Views.BinEditorView">
  <UserControl.Styles>
    <Style Selector="Button.bin">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="Padding" Value="8,8" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="MinHeight" Value="96" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource InsetBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InsetEdgeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.bin.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource TealBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.bin.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource TealBrush}" />
    </Style>
    <Style Selector="Button.bin.off">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="ToggleButton.opt">
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="12">
    <!-- bins in use + presets -->
    <WrapPanel>
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,24,6">
        <TextBlock Text="Bins in use" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{x:Static vm:BinEditorViewModel.BinCountList}" SelectedItem="{Binding BinsInUse}" Width="80" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
        <TextBlock Text="Fill all bins from a preset" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{x:Static vm:BinEditorViewModel.PresetList}" SelectedItem="{Binding Preset}" Width="210" />
        <Button Content="Fill" Command="{Binding ApplyPresetCommand}"
                ToolTip.Tip="Replaces every bin's rule with the preset. Then change any bin you like." />
      </StackPanel>
    </WrapPanel>

    <!-- the machine, feeder to end -->
    <StackPanel Spacing="4">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Classes="muted" FontSize="11" Text="▶ feeder" />
        <TextBlock Grid.Column="2" Classes="muted" FontSize="11" Text="end of the line ▶" />
      </Grid>
      <ItemsControl ItemsSource="{Binding Slots}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Classes="bin" Classes.selected="{Binding IsSelected}" Classes.off="{Binding IsOff}"
                    Command="{Binding $parent[ItemsControl].DataContext.SelectCommand}" CommandParameter="{Binding}"
                    ToolTip.Tip="{Binding Summary}">
              <StackPanel Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="{Binding Bin}" FontSize="18" FontWeight="Bold" />
                  <TextBlock Text="⚑" Foreground="#F59E0B" IsVisible="{Binding IsEnd}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding Summary}" FontSize="11" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Role}" FontSize="10" Classes="muted" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                 Text="Each card goes to the first bin (from the feeder) whose rule fits. Flagged cards and anything no bin takes go to the end bin ⚑." />
    </StackPanel>

    <!-- the selected bin -->
    <Border Classes="card" Padding="14" IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Spacing="10" DataContext="{Binding Selected}">
        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding $parent[UserControl].DataContext.SelectedHeader}" />

        <TextBlock IsVisible="{Binding IsEnd}" TextWrapping="Wrap"
                   Text="The end of the line: cards that aren't sure (Flagged), and anything no other bin takes, land here. Use more bins to give this bin a rule of its own." />
        <TextBlock IsVisible="{Binding !CanHaveRule}" Classes="muted" TextWrapping="Wrap"
                   Text="Bin 9 is the last bin there is, so it's only ever the end of the line." />
        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsOff}">
          <TextBlock Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap"
                     Text="This bin is off. Its rule is kept for when you turn it on; until then its cards ride to the end bin." />
          <Button Content="{Binding $parent[UserControl].DataContext.TurnOnText}" Command="{Binding $parent[UserControl].DataContext.TurnOnUpToCommand}" />
        </StackPanel>

        <StackPanel Spacing="10" IsVisible="{Binding ShowRule}">
          <Grid ColumnDefinitions="Auto,12,240,24,Auto,12,*">
            <TextBlock Text="Takes" VerticalAlignment="Center" />
            <ComboBox Grid.Column="2" ItemsSource="{x:Static vm:BinSlot.KindList}" SelectedItem="{Binding Kind}" HorizontalAlignment="Stretch" />
            <TextBlock Grid.Column="4" Text="Name (optional)" VerticalAlignment="Center" />
            <TextBox Grid.Column="6" Text="{Binding Name}" Watermark="{Binding Summary}" />
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsPrice}">
            <TextBlock Text="From $" VerticalAlignment="Center" />
            <TextBox Text="{Binding MinText}" Width="90" Watermark="0" />
            <TextBlock Text="up to $" VerticalAlignment="Center" />
            <TextBox Text="{Binding MaxText}" Width="90" Watermark="no limit" />
            <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center" Text="(both prices included: a card at exactly the top price stays in this bin)" />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding Colors}" IsVisible="{Binding IsColor}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate><ToggleButton Classes="opt" Content="{Binding Text}" IsChecked="{Binding IsOn}" /></DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Spacing="4" IsVisible="{Binding IsLetters}">
            <TextBox Text="{Binding Letters}" Watermark="A-F   (or several: A-C, Q, #)" Width="260" HorizontalAlignment="Left" />
            <TextBlock Classes="muted" FontSize="12" Text="First letter of the card's name. # = starts with a number or symbol. Æ counts as A." />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding Rarities}" IsVisible="{Binding IsRarity}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate><ToggleButton Classes="opt" Content="{Binding Text}" IsChecked="{Binding IsOn}" /></DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Spacing="4" IsVisible="{Binding IsSet}">
            <TextBox Text="{Binding SetsText}" Watermark="MH3, MH2, TRK" Width="360" HorizontalAlignment="Left" />
            <TextBlock Classes="muted" FontSize="12" Text="Set codes (the 3–5 letters in the bottom-left corner)." />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding Types}" IsVisible="{Binding IsType}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate><ToggleButton Classes="opt" Content="{Binding Text}" IsChecked="{Binding IsOn}" /></DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock IsVisible="{Binding IsAnything}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                     Text="Takes every card that reached it (bins closer to the feeder get first pick)." />
          <TextBlock IsVisible="{Binding IsEmpty}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                     Text="Nothing goes in this bin: the door stays shut." />
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
