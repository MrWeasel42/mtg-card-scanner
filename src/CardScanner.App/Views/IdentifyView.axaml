<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CardScanner.App.Views.IdentifyView"
             DragDrop.AllowDrop="True">
  <UserControl.Styles>
    <Style Selector="Border.choice">
      <Setter Property="Padding" Value="8" />
      <Setter Property="Margin" Value="0,0,10,10" />
      <Setter Property="Background" Value="#0F1528" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelEdgeBrush}" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Border.choice:pointerover">
      <Setter Property="BorderBrush" Value="{StaticResource TealBrush}" />
    </Style>
    <Style Selector="Border.choice.chosen">
      <Setter Property="BorderBrush" Value="#22C55E" />
    </Style>
    <!-- Clickable pictures: open the big compare view -->
    <Style Selector="Button.imgbtn">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.imgbtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.imgbtn:pointerover Border.pic">
      <Setter Property="BorderBrush" Value="{StaticResource TealBrush}" />
    </Style>
    <Style Selector="Border.pic">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.tab">
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.tab.on">
      <Setter Property="BorderBrush" Value="{StaticResource TealBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Rectangle.dropzone">
      <Setter Property="Stroke" Value="#3A4A6B" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="StrokeDashArray" Value="6,4" />
      <Setter Property="RadiusX" Value="16" />
      <Setter Property="RadiusY" Value="16" />
      <Setter Property="Fill" Value="#0C132588" />
    </Style>
    <Style Selector="Panel.hover Rectangle.dropzone">
      <Setter Property="Stroke" Value="{StaticResource TealBrush}" />
      <Setter Property="Fill" Value="#102A3355" />
    </Style>
  </UserControl.Styles>

  <Panel>
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="20,16,20,0">
    <!-- Toolbar -->
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock Classes="h1" Text="Identify card photos" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="🎯" VerticalAlignment="Center" />
          <TextBlock Classes="muted" Text="{Binding ScoreText}" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Name="AddButton" Classes="accent" Content="＋ Add photos" />
        <Button Content="Clear" Command="{Binding ClearCommand}" />
        <Button Content="📄 Results log" Command="{Binding OpenLogFolderCommand}" />
      </StackPanel>
    </Grid>

    <!-- Drop zone: big with artwork when empty, a slim strip once results exist -->
    <Panel Grid.Row="1" Name="DropZone" Margin="0,16,0,12">
      <Rectangle Classes="dropzone" />
      <StackPanel Spacing="10" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsVisible="{Binding !HasResults}">
        <Image Source="/Assets/cards.png" Width="210" HorizontalAlignment="Center" />
        <TextBlock Text="Drop card photos here" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
        <TextBlock Classes="muted" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520"
                   Text="Single photos or whole folders (like raw, single sleeve, double sleeve). One card per photo, on a plain background that contrasts with the card's border." />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,12" HorizontalAlignment="Center"
                  IsVisible="{Binding HasResults}">
        <Image Source="/Assets/logo.png" Width="22" Height="22" />
        <TextBlock Text="Drop more photos or folders anywhere here" VerticalAlignment="Center" />
      </StackPanel>
    </Panel>

    <!-- Busy -->
    <Border Grid.Row="2" Classes="card" Padding="14,10" Margin="0,0,0,12" IsVisible="{Binding IsBusy}">
      <StackPanel Spacing="6">
        <TextBlock Classes="teal" FontWeight="SemiBold" Text="{Binding BusyText}" />
        <ProgressBar IsIndeterminate="True" Height="4" />
      </StackPanel>
    </Border>

    <!-- Review queue tabs -->
    <StackPanel Grid.Row="3" Spacing="8" Margin="0,0,0,12" IsVisible="{Binding HasResults}">
      <WrapPanel>
        <Button Classes="tab" Classes.on="{Binding IsQueue}" Content="{Binding QueueLabel}" Margin="0,0,8,6"
                Command="{Binding SetFilterCommand}" CommandParameter="Queue"
                ToolTip.Tip="Cards the scanner couldn't pin down. Each one drops off once you mark it." />
        <Button Classes="tab" Classes.on="{Binding IsGood}" Content="{Binding GoodLabel}" Margin="0,0,8,6"
                Command="{Binding SetFilterCommand}" CommandParameter="Good"
                ToolTip.Tip="Name, set code and collector number all agree. Almost always right." />
        <Button Classes="tab" Classes.on="{Binding IsDone}" Content="{Binding DoneLabel}" Margin="0,0,8,6"
                Command="{Binding SetFilterCommand}" CommandParameter="Done"
                ToolTip.Tip="Cards you've already marked. Change your answer here if you need to." />
        <Button Classes="tab" Classes.on="{Binding IsAll}" Content="{Binding AllLabel}" Margin="0,0,8,6"
                Command="{Binding SetFilterCommand}" CommandParameter="All" />
        <Button Content="✓ Mark all pinned correct" Margin="12,0,0,6" Padding="12,6" FontSize="13"
                Command="{Binding AcceptGoodCommand}" IsEnabled="{Binding CanAcceptGood}"
                ToolTip.Tip="Marks every card in the Pinned tab as the correct printing, so they're logged too." />
      </WrapPanel>
      <TextBlock Classes="muted" Text="{Binding EmptyFilterText}" TextWrapping="Wrap"
                 IsVisible="{Binding EmptyFilterText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>

    <!-- Results -->
    <ScrollViewer Grid.Row="4" Padding="0,0,6,16">
      <ItemsControl ItemsSource="{Binding Results}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="card" IsVisible="{Binding IsShown}" Margin="0,0,0,14">
              <Grid ColumnDefinitions="190,*">
                <!-- What the camera saw, straightened -->
                <StackPanel Spacing="8">
                  <TextBlock Classes="muted" FontSize="11" Text="YOUR PHOTO" FontWeight="SemiBold" LetterSpacing="1" />
                  <Button Classes="imgbtn" Command="{Binding CompareCommand}" HorizontalAlignment="Left"
                          ToolTip.ShowDelay="250" ToolTip.Placement="Right">
                    <ToolTip.Tip>
                      <StackPanel Spacing="4">
                        <Image Source="{Binding FullImage}" Width="420" Height="586" Stretch="Uniform" />
                        <TextBlock FontSize="11" Text="Click to compare side by side, full window" HorizontalAlignment="Center" />
                      </StackPanel>
                    </ToolTip.Tip>
                    <Border Classes="pic" CornerRadius="10" ClipToBounds="True" Width="176" BoxShadow="0 4 12 0 #60000000">
                      <Image Source="{Binding CardImage}" Stretch="Uniform" />
                    </Border>
                  </Button>
                  <TextBlock Classes="muted" FontSize="11" Text="{Binding Photo}" TextTrimming="CharacterEllipsis" />
                  <Button Content="↻ Flip" FontSize="12" Padding="10,4" IsVisible="{Binding CanFlip}"
                          Command="{Binding FlipCommand}"
                          ToolTip.Tip="Card upside down? Turn it around and identify it again" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="12" Margin="18,0,0,0">
                  <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="#F87171" TextWrapping="Wrap" />

                  <!-- Best match -->
                  <Panel IsVisible="{Binding HasResult}">
                    <Grid ColumnDefinitions="Auto,*" DataContext="{Binding Top}">
                      <Button Classes="imgbtn" Command="{Binding CompareCommand}" VerticalAlignment="Top"
                              ToolTip.ShowDelay="250" ToolTip.Placement="Right">
                        <ToolTip.Tip>
                      <StackPanel Spacing="4">
                        <Image Source="{Binding FullImage}" Width="420" Height="586" Stretch="Uniform" />
                        <TextBlock FontSize="11" Text="Click to compare side by side, full window" HorizontalAlignment="Center" />
                      </StackPanel>
                    </ToolTip.Tip>
                        <Border Classes="pic" CornerRadius="9" ClipToBounds="True" Width="132" BoxShadow="0 4 12 0 #60000000">
                          <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                        </Border>
                      </Button>
                      <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="4">
                        <TextBlock Classes="teal" FontSize="11" Text="BEST MATCH" FontWeight="SemiBold" LetterSpacing="1" />
                        <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SetLabel}" TextWrapping="Wrap" />
                        <TextBlock Classes="gold" Text="{Binding Extra}" TextWrapping="Wrap" />
                        <Border Classes="pill" HorizontalAlignment="Left" Margin="0,4,0,0">
                          <TextBlock Classes="muted" FontSize="12" Text="{Binding ScoreText}" />
                        </Border>
                      </StackPanel>
                    </Grid>
                  </Panel>

                  <StackPanel Spacing="6" IsVisible="{Binding HasResult}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Classes="pill" Background="#1A22C55E" BorderBrush="#22C55E" IsVisible="{Binding IsPinned}"
                              ToolTip.Tip="The name, set code and collector number on the card all match this printing">
                        <TextBlock Text="📌 Pinned: name + set + number agree" FontSize="12" Foreground="#4ADE80" />
                      </Border>
                      <Border Classes="pill" Background="#1AF59E0B" BorderBrush="#F59E0B" IsVisible="{Binding IsFlagged}">
                        <TextBlock Text="{Binding FlagReason, StringFormat='⚠ Needs a look: {0}'}" FontSize="12" Foreground="#FBBF24" TextWrapping="Wrap" />
                      </Border>
                    </StackPanel>
                    <TextBlock Classes="muted" FontSize="12" Text="{Binding ReadText}" TextWrapping="Wrap" />
                  </StackPanel>

                  <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasResult}">
                    <Button Classes="accent" Content="✓ Correct printing" Command="{Binding MarkTopCorrectCommand}" />
                    <Button Content="≈ Right card, wrong printing" Command="{Binding MarkNameOnlyCommand}"
                            ToolTip.Tip="The card name is right but the set/number isn't, and the right printing isn't listed" />
                    <Button Content="✗ Wrong card" Command="{Binding MarkNotListedCommand}" />
                    <TextBlock Text="{Binding VerdictText}" Foreground="{Binding VerdictBrush}"
                               VerticalAlignment="Center" FontWeight="SemiBold" Margin="6,0,0,0" />
                  </StackPanel>

                  <!-- Other candidates -->
                  <StackPanel Spacing="6" IsVisible="{Binding HasResult}">
                    <TextBlock Classes="muted" FontSize="12" Text="Not that printing? If the right one is here, pick it (click a picture to compare big):" />
                    <ItemsControl ItemsSource="{Binding Others}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Classes="choice" Classes.chosen="{Binding IsChosen}" Width="180">
                            <StackPanel Spacing="4">
                              <Button Classes="imgbtn" Command="{Binding CompareCommand}" HorizontalAlignment="Center"
                                      ToolTip.ShowDelay="250" ToolTip.Placement="Top">
                                <ToolTip.Tip>
                      <StackPanel Spacing="4">
                        <Image Source="{Binding FullImage}" Width="420" Height="586" Stretch="Uniform" />
                        <TextBlock FontSize="11" Text="Click to compare side by side, full window" HorizontalAlignment="Center" />
                      </StackPanel>
                    </ToolTip.Tip>
                                <Border Classes="pic" CornerRadius="7" ClipToBounds="True" Height="150">
                                  <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                </Border>
                              </Button>
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding SetLabel}" FontSize="11" TextWrapping="Wrap" />
                              <TextBlock Classes="gold" Text="{Binding Extra}" FontSize="11" TextWrapping="Wrap" />
                              <Button Content="✓ This printing" FontSize="12" Padding="10,4" HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Center" Command="{Binding PickCommand}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <TextBlock Classes="muted" FontSize="11" Text="{Binding Notes}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>

  <!-- Big side-by-side compare view -->
  <Grid Name="CompareOverlay" IsVisible="{Binding IsComparing}" Background="#E6050810">
    <Grid DataContext="{Binding Compare}" RowDefinitions="Auto,*,Auto" Margin="28,18">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Classes="muted" FontSize="12" Text="{Binding Counter}" />
          <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" />
          <TextBlock Text="{Binding Subtitle}" />
          <TextBlock Classes="gold" Text="{Binding Extra}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
          <Button Content="{Binding ZoomLabel}" Command="{Binding ToggleZoomCommand}" />
          <Button Content="✕ Close" Command="{Binding CloseCommand}" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,14">
        <DockPanel Margin="0,0,10,0">
          <TextBlock DockPanel.Dock="Top" Classes="muted" FontSize="12" FontWeight="SemiBold" LetterSpacing="1"
                     Text="YOUR PHOTO" HorizontalAlignment="Center" Margin="0,0,0,6" />
          <Image Source="{Binding LeftShown}" Stretch="Uniform" />
        </DockPanel>
        <DockPanel Grid.Column="1" Margin="10,0,0,0">
          <TextBlock DockPanel.Dock="Top" Classes="teal" FontSize="12" FontWeight="SemiBold" LetterSpacing="1"
                     Text="CATALOG PRINTING" HorizontalAlignment="Center" Margin="0,0,0,6" />
          <Image Source="{Binding RightShown}" Stretch="Uniform" />
        </DockPanel>
      </Grid>

      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
        <Button Content="◀ Previous option" Command="{Binding PreviousCommand}" />
        <Button Classes="accent" Content="✓ This is the one" Command="{Binding PickThisCommand}" Padding="22,8" />
        <Button Content="Next option ▶" Command="{Binding NextCommand}" />
      </StackPanel>
    </Grid>
  </Grid>
  </Panel>
</UserControl>
