<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CardScanner.App.Views.IdentifyView"
             DragDrop.AllowDrop="True">
  <UserControl.Styles>
    <Style Selector="Border.choice">
      <Setter Property="Padding" Value="8" />
      <Setter Property="Margin" Value="0,0,10,10" />
      <Setter Property="Background" Value="#0F1528" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelEdgeBrush}" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Border.choice:pointerover">
      <Setter Property="BorderBrush" Value="{StaticResource TealBrush}" />
    </Style>
    <Style Selector="Border.choice.chosen">
      <Setter Property="BorderBrush" Value="#22C55E" />
    </Style>
    <!-- Clickable pictures: open the big compare view -->
    <Style Selector="Button.imgbtn">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.imgbtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.imgbtn:pointerover Border.pic">
      <Setter Property="BorderBrush" Value="{StaticResource TealBrush}" />
    </Style>
    <Style Selector="Border.pic">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.tab">
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.tab.on">
      <Setter Property="BorderBrush" Value="{StaticResource TealBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Rectangle.dropzone">
      <Setter Property="Stroke" Value="#3A4A6B" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="StrokeDashArray" Value="6,4" />
      <Setter Property="RadiusX" Value="16" />
      <Setter Property="RadiusY" Value="16" />
      <Setter Property="Fill" Value="#0C132588" />
    </Style>
    <Style Selector="Panel.hover Rectangle.dropzone">
      <Setter Property="Stroke" Value="{StaticResource TealBrush}" />
      <Setter Property="Fill" Value="#102A3355" />
    </Style>
  </UserControl.Styles>

  <Panel>
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="20,16,20,0">
    <!-- Toolbar -->
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock Classes="h1" Text="Identify card photos" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="🎯" VerticalAlignment="Center" />
          <TextBlock Classes="muted" Text="{Binding ScoreText}" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Name="AddButton" Classes="accent" Content="＋ Add photos" />
        <Button Content="Clear" Command="{Binding ClearCommand}" />
        <Button Content="📄 Results log" Command="{Binding OpenLogFolderCommand}" />
      </StackPanel>
    </Grid>

    <!-- Drop zone: big with artwork when empty, a slim strip once results exist -->
    <Panel Grid.Row="1" Name="DropZone" Margin="0,16,0,12">
      <Rectangle Classes="dropzone" />
      <StackPanel Spacing="10" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsVisible="{Binding !HasResults}">
        <Image Source="/Assets/cards.png" Width="210" HorizontalAlignment="Center" />
        <TextBlock Text="Drop card photos here" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
        <TextBlock Classes="muted" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520"
                   Text="Single photos or whole folders (like raw, single sleeve, double sleeve). One card per photo, on a plain background that contrasts with the card's border." />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,12" HorizontalAlignment="Center"
                  IsVisible="{Binding HasResults}">
        <Image Source="/Assets/logo.png" Width="22" Height="22" />
        <TextBlock Text="Drop more photos or folders anywhere here" VerticalAlignment="Center" />
      </StackPanel>
    </Panel>

    <!-- Busy -->
    <Border Grid.Row="2" Classes="card" Padding="14,10" Margin="0,0,0,12" IsVisible="{Binding IsBusy}">
      <StackPanel Spacing="6">
        <TextBlock Classes="teal" FontWeight="SemiBold" Text="{Binding BusyText}" />
        <ProgressBar IsIndeterminate="True" Height="4" />
      </StackPanel>
    </Border>

    <!-- Review queue tabs -->
    <StackPanel Grid.Row="3" Spacing="8" Margin="0,0,0,12" IsVisible="{Binding HasResults}">
      <WrapPanel>
        <Button Classes="tab" Classes.on="{Binding IsQueue}" Content="{Binding QueueLabel}" Margin="0,0,8,6"
                Command="{Binding SetFilterCommand}" CommandParameter="Queue"
                ToolTip.Tip="Cards the scanner couldn't pin down. Each one drops off once you mark it." />
        <Button Classes="tab" Classes.on="{Binding IsGood}" Content="{Binding GoodLabel}" Margin="0,0,8,6"
                Command="{Binding SetFilterCommand}" CommandParameter="Good"
                ToolTip.Tip="Name, set code and collector number all agree. Almost always right." />
        <Button Classes="tab" Classes.on="{Binding IsFinish}" Content="{Binding FinishLabel}" Margin="0,0,8,6"
                Command="{Binding SetFilterCommand}" CommandParameter="Finish"
                ToolTip.Tip="Printing is pinned, but foil / non-foil couldn't be read from the photo. Set the Finish, or confirm Non-foil." />
        <Button Classes="tab" Classes.on="{Binding IsDone}" Content="{Binding DoneLabel}" Margin="0,0,8,6"
                Command="{Binding SetFilterCommand}" CommandParameter="Done"
                ToolTip.Tip="Cards you've already marked. Change your answer here if you need to." />
        <Button Classes="tab" Classes.on="{Binding IsAll}" Content="{Binding AllLabel}" Margin="0,0,8,6"
                Command="{Binding SetFilterCommand}" CommandParameter="All" />
        <Button Content="✓ Mark all pinned correct" Margin="12,0,0,6" Padding="12,6" FontSize="13"
                Command="{Binding AcceptGoodCommand}" IsEnabled="{Binding CanAcceptGood}"
                ToolTip.Tip="Marks every card in the Pinned tab as the correct printing, so they're logged too." />
      </WrapPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox Text="{Binding SearchText}" Watermark="🔍 Search this tab: card name, set, or scan number" Width="440" />
        <Button Padding="12,6" ToolTip.Tip="Filter by rarity or price, and change the sort order">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <!-- funnel -->
            <Path Data="M0,0 L14,0 L8.5,6.5 L8.5,12 L5.5,10.5 L5.5,6.5 Z" Fill="{StaticResource TealBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding FilterLabel}" VerticalAlignment="Center" FontSize="13" />
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <StackPanel Spacing="10" Width="260" Margin="4">
                <TextBlock Text="Rarity" FontWeight="SemiBold" FontSize="12" />
                <ComboBox ItemsSource="{Binding RarityOptions}" SelectedItem="{Binding RarityFilter}" HorizontalAlignment="Stretch" />
                <TextBlock Text="Price (in the finish set for the card)" FontWeight="SemiBold" FontSize="12" />
                <ComboBox ItemsSource="{Binding PriceOptions}" SelectedItem="{Binding PriceFilter}" HorizontalAlignment="Stretch" />
                <TextBlock Text="Sort" FontWeight="SemiBold" FontSize="12" />
                <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortOrder}" HorizontalAlignment="Stretch" />
                <Button Content="Reset filters" Command="{Binding ResetFiltersCommand}" HorizontalAlignment="Right" FontSize="12" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
      <TextBlock Classes="muted" Text="{Binding EmptyFilterText}" TextWrapping="Wrap"
                 IsVisible="{Binding EmptyFilterText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>

    <!-- Results -->
    <ScrollViewer Grid.Row="4" Padding="0,0,6,16">
      <ItemsControl ItemsSource="{Binding Shown}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="card" IsVisible="{Binding IsShown}" Margin="0,0,0,14">
              <Grid ColumnDefinitions="190,*">
                <!-- What the camera saw, straightened -->
                <StackPanel Spacing="8">
                  <TextBlock Classes="muted" FontSize="11" Text="YOUR PHOTO" FontWeight="SemiBold" LetterSpacing="1" />
                  <Button Classes="imgbtn" Command="{Binding CompareCommand}" HorizontalAlignment="Left"
                          ToolTip.ShowDelay="250" ToolTip.Placement="Right">
                    <ToolTip.Tip>
                      <StackPanel Spacing="4">
                        <Image Source="{Binding FullImage}" Width="420" Height="586" Stretch="Uniform" />
                        <TextBlock FontSize="11" Text="Click to compare side by side, full window" HorizontalAlignment="Center" />
                      </StackPanel>
                    </ToolTip.Tip>
                    <Border Classes="pic" CornerRadius="10" ClipToBounds="True" Width="176" BoxShadow="0 4 12 0 #60000000">
                      <Image Source="{Binding CardImage}" Stretch="Uniform" />
                    </Border>
                  </Button>
                  <TextBlock Classes="muted" FontSize="11" Text="{Binding ScanLabel}" ToolTip.Tip="{Binding Photo}" TextTrimming="CharacterEllipsis" />
                  <Button Content="{Binding FlipLabel}" FontSize="12" Padding="10,4" IsVisible="{Binding CanFlip}"
                          Command="{Binding FlipCommand}"
                          ToolTip.Tip="Card upside down? Turn it around and identify it again" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="12" Margin="18,0,0,0">
                  <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="#F87171" TextWrapping="Wrap" />

                  <!-- Best match -->
                  <Panel IsVisible="{Binding HasResult}">
                    <Grid ColumnDefinitions="Auto,*" DataContext="{Binding Top}">
                      <Button Classes="imgbtn" Command="{Binding CompareCommand}" VerticalAlignment="Top"
                              ToolTip.ShowDelay="250" ToolTip.Placement="Right">
                        <ToolTip.Tip>
                      <StackPanel Spacing="4">
                        <Image Source="{Binding FullImage}" Width="420" Height="586" Stretch="Uniform" />
                        <TextBlock FontSize="11" Text="Click to compare side by side, full window" HorizontalAlignment="Center" />
                      </StackPanel>
                    </ToolTip.Tip>
                        <Border Classes="pic" CornerRadius="9" ClipToBounds="True" Width="132" BoxShadow="0 4 12 0 #60000000">
                          <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                        </Border>
                      </Button>
                      <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="4">
                        <TextBlock Classes="teal" FontSize="11" Text="BEST MATCH" FontWeight="SemiBold" LetterSpacing="1" />
                        <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SetLabel}" TextWrapping="Wrap" />
                        <TextBlock Classes="gold" Text="{Binding Extra}" TextWrapping="Wrap" />
                        <Border Classes="pill" HorizontalAlignment="Left" Background="{Binding RarityBackground}" BorderBrush="{Binding RarityBorder}" BorderThickness="1" IsVisible="{Binding HasRarity}">
                          <TextBlock Text="{Binding Rarity}" FontSize="12" FontWeight="Bold" Foreground="{Binding RarityForeground}" />
                        </Border>
                        <Border Classes="pill" HorizontalAlignment="Left" Margin="0,4,0,0">
                          <TextBlock Classes="muted" FontSize="12" Text="{Binding ScoreText}" />
                        </Border>
                      </StackPanel>
                    </Grid>
                  </Panel>

                  <StackPanel Spacing="6" IsVisible="{Binding HasResult}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Classes="pill" Background="#1A22C55E" BorderBrush="#22C55E" IsVisible="{Binding IsPinned}"
                              ToolTip.Tip="What printed on the card pins this exact printing">
                        <TextBlock Text="{Binding PinText}" FontSize="12" Foreground="#4ADE80" />
                      </Border>
                      <Border Classes="pill" Background="#1A2DD4BF" BorderBrush="#2DD4BF" IsVisible="{Binding IsSoftPin}"
                              ToolTip.Tip="Pinned without a printed set code (older and retro frames, Japanese printings). Worth a glance when spot-checking.">
                        <TextBlock Text="worth a glance" FontSize="12" Foreground="#5EEAD4" />
                      </Border>
                      <Border Classes="pill" Background="#1AF59E0B" BorderBrush="#F59E0B" IsVisible="{Binding IsFlagged}">
                        <TextBlock Text="{Binding FlagReason, StringFormat='⚠ Needs a look: {0}'}" FontSize="12" Foreground="#FBBF24" TextWrapping="Wrap" />
                      </Border>
                    </StackPanel>
                    <TextBlock Classes="muted" FontSize="12" Text="{Binding ReadText}" TextWrapping="Wrap" />
                    <TextBlock Classes="teal" FontSize="12" Text="{Binding DetailNote, StringFormat='🔎 {0}'}" TextWrapping="Wrap"
                               IsVisible="{Binding DetailNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="Finish:" VerticalAlignment="Center" FontWeight="SemiBold" />
                      <ComboBox ItemsSource="{Binding FinishOptions}" SelectedItem="{Binding SelectedFinish}"
                                IsEnabled="{Binding HasFinishChoice}" MinWidth="150" FontSize="13"
                                ToolTip.Tip="Foil or not, for this printing. Only finishes this printing was made in are listed." />
                      <TextBlock Text="{Binding FinishNote}" VerticalAlignment="Center" FontSize="12"
                                 Classes="muted" IsVisible="{Binding !FinishUnsure}" />
                      <TextBlock Text="{Binding FinishNote, StringFormat='⚠ {0}'}" VerticalAlignment="Center" FontSize="12"
                                 Foreground="#FBBF24" IsVisible="{Binding FinishUnsure}" />
                    </StackPanel>
                  </StackPanel>

                  <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasResult}">
                    <Button Classes="accent" Content="✓ Correct printing" Command="{Binding MarkTopCorrectCommand}" />
                    <Button Content="≈ Right card, wrong printing" Command="{Binding MarkNameOnlyCommand}"
                            ToolTip.Tip="The card name is right but the set/number isn't, and the right printing isn't listed" />
                    <Button Content="✗ Wrong card" Command="{Binding MarkNotListedCommand}" />
                    <TextBlock Text="{Binding VerdictText}" Foreground="{Binding VerdictBrush}"
                               VerticalAlignment="Center" FontWeight="SemiBold" Margin="6,0,0,0" />
                  </StackPanel>

                  <!-- Other candidates -->
                  <StackPanel Spacing="6" IsVisible="{Binding HasResult}">
                    <TextBlock Classes="muted" FontSize="12" Text="Not that printing? If the right one is here, pick it (click a picture to compare big):" />
                    <ItemsControl ItemsSource="{Binding Others}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Classes="choice" Classes.chosen="{Binding IsChosen}" Width="180">
                            <StackPanel Spacing="4">
                              <Button Classes="imgbtn" Command="{Binding CompareCommand}" HorizontalAlignment="Center"
                                      ToolTip.ShowDelay="250" ToolTip.Placement="Top">
                                <ToolTip.Tip>
                      <StackPanel Spacing="4">
                        <Image Source="{Binding FullImage}" Width="420" Height="586" Stretch="Uniform" />
                        <TextBlock FontSize="11" Text="Click to compare side by side, full window" HorizontalAlignment="Center" />
                      </StackPanel>
                    </ToolTip.Tip>
                                <Border Classes="pic" CornerRadius="7" ClipToBounds="True" Height="150">
                                  <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                </Border>
                              </Button>
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding SetLabel}" FontSize="11" TextWrapping="Wrap" />
                              <TextBlock Classes="gold" Text="{Binding Extra}" FontSize="11" TextWrapping="Wrap" />
                              <Button Content="✓ This printing" FontSize="12" Padding="10,4" HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Center" Command="{Binding PickCommand}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <TextBlock Classes="muted" FontSize="11" Text="{Binding Notes}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>

  <!-- Big side-by-side compare view -->
  <Grid Name="CompareOverlay" IsVisible="{Binding IsComparing}" Background="#E6050810">
    <Grid DataContext="{Binding Compare}" RowDefinitions="Auto,*,Auto" ColumnDefinitions="Auto,*,Auto" Margin="28,18">

      <!-- Top bar: layout choice and Close (always); queue + tags centered in the "Tags on top" layout -->
      <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="12" VerticalAlignment="Top"
                  IsVisible="{Binding IsTopLayout}">
        <TextBlock Classes="teal" FontSize="12" FontWeight="SemiBold" Text="{Binding QueueText}" VerticalAlignment="Center" />
        <TextBlock Classes="muted" FontSize="12" Text="{Binding Counter}" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="4" MaxWidth="1100" HorizontalAlignment="Center" Margin="0,22,0,0"
                  IsVisible="{Binding IsTopLayout}">
            <WrapPanel DataContext="{Binding Item}" HorizontalAlignment="Center">
              <Border Classes="pill" Background="#1A22C55E" BorderBrush="#22C55E" IsVisible="{Binding IsPinned}" Margin="0,0,8,6">
                <TextBlock Text="{Binding PinText}" FontSize="12" Foreground="#4ADE80" TextWrapping="Wrap" />
              </Border>
              <Border Classes="pill" Background="#1A2DD4BF" BorderBrush="#2DD4BF" IsVisible="{Binding IsSoftPin}" Margin="0,0,8,6">
                <TextBlock Text="worth a glance" FontSize="12" Foreground="#5EEAD4" />
              </Border>
              <Border Classes="pill" Background="#1AF59E0B" BorderBrush="#F59E0B" IsVisible="{Binding IsFlagged}" Margin="0,0,8,6">
                <TextBlock Text="{Binding FlagReason, StringFormat='⚠ Needs a look: {0}'}" FontSize="12" Foreground="#FBBF24" TextWrapping="Wrap" MaxWidth="900" />
              </Border>
              <Border Classes="pill" Background="#1AF59E0B" BorderBrush="#F59E0B" IsVisible="{Binding FinishUnsure}" Margin="0,0,8,6">
                <TextBlock Text="{Binding FinishNote, StringFormat='✨ Finish: {0}'}" FontSize="12" Foreground="#FBBF24" TextWrapping="Wrap" MaxWidth="900" />
              </Border>
            </WrapPanel>
            <TextBlock DataContext="{Binding Item}" Classes="teal" FontSize="12" Text="{Binding DetailNote, StringFormat='🔎 {0}'}" TextAlignment="Center"
                       IsVisible="{Binding DetailNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
            <TextBlock DataContext="{Binding Item}" Classes="muted" FontSize="11" Text="{Binding ReadText}" TextWrapping="Wrap" TextAlignment="Center" />
            <StackPanel DataContext="{Binding Item}" Spacing="6" HorizontalAlignment="Center" Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Condition:" VerticalAlignment="Center" FontWeight="SemiBold" />
                  <ComboBox ItemsSource="{Binding Conditions}" SelectedItem="{Binding Condition}" MinWidth="170"
                            ToolTip.Tip="Near Mint unless you change it. Setting it doesn't count as verifying the card." />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="14">
                  <CheckBox Content="Altered" IsChecked="{Binding Altered}" />
                  <CheckBox Content="Misprint" IsChecked="{Binding Misprint}" />
                </StackPanel>
              </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Top">
        <ComboBox ItemsSource="{Binding LayoutOptions}" SelectedItem="{Binding LayoutChoice}" FontSize="12" MinWidth="160"
                  ToolTip.Tip="Where the card info and buttons go. Remembered next time." />
        <Button Content="✕ Close" Command="{Binding CloseCommand}" />
      </StackPanel>

      <!-- Side panel (left or right): queue, scan number, tags, what was read, and all the buttons -->
      <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="{Binding PanelColumn}" IsVisible="{Binding IsPanelLayout}"
              Width="330" Margin="0,14,0,0" Padding="18" CornerRadius="14" Background="#0B1220" BorderBrush="#1E293B" BorderThickness="1">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Spacing="8">
            <Button Classes="accent" Content="✓ This is the one" Command="{Binding PickThisCommand}" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" Padding="0,10" ToolTip.Tip="Marks this printing and moves to the next card (Enter)" />
            <UniformGrid Columns="2">
              <Button Content="◀ Previous option" Command="{Binding PreviousCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,4,0" />
              <Button Content="Next option ▶" Command="{Binding NextCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="4,0,0,0" />
            </UniformGrid>
            <UniformGrid Columns="2">
              <Button Content="◀ Last card" Command="{Binding LastCardCommand}" IsEnabled="{Binding CanGoBack}" FontSize="12"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,4,0"
                      ToolTip.Tip="Back to the card before this one, to fix a mis-click (Backspace)" />
              <Button Content="Skip card ⏭" Command="{Binding SkipCommand}" FontSize="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Margin="4,0,0,0" ToolTip.Tip="Leave this one for later and look at the next card (S)" />
            </UniformGrid>
            <UniformGrid Columns="2">
              <Button Content="{Binding ZoomLabel}" Command="{Binding ToggleZoomCommand}" FontSize="12" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center" Margin="0,0,4,0"
                      ToolTip.Tip="Show just the bottom of both cards (Z). Hovering over a card magnifies it; M turns the magnifier on/off." />
              <Button Content="{Binding FlipLabel}" Command="{Binding FlipCommand}" FontSize="12" IsEnabled="{Binding CanFlip}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="4,0,0,0"
                      ToolTip.Tip="Card upside down? Identify it again turned around (F)" />
            </UniformGrid>
            <Button Content="≈ Right card, printing not listed" Command="{Binding NameOnlyCommand}" FontSize="12"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button Content="✗ Wrong card" Command="{Binding WrongCardCommand}" FontSize="12"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          </StackPanel>
          <ScrollViewer>
            <StackPanel Spacing="10">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="teal" FontSize="12" FontWeight="SemiBold" Text="{Binding QueueText}" />
                <TextBlock Classes="muted" FontSize="12" Text="{Binding Counter}" />
              </StackPanel>
              <TextBlock Text="{Binding PhotoName}" FontSize="16" Classes="muted" />
              <Border Height="1" Background="#1E293B" />
              <StackPanel DataContext="{Binding Item}" Spacing="6" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Condition:" VerticalAlignment="Center" FontWeight="SemiBold" />
                  <ComboBox ItemsSource="{Binding Conditions}" SelectedItem="{Binding Condition}" MinWidth="170"
                            ToolTip.Tip="Near Mint unless you change it. Setting it doesn't count as verifying the card." />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="14">
                  <CheckBox Content="Altered" IsChecked="{Binding Altered}" />
                  <CheckBox Content="Misprint" IsChecked="{Binding Misprint}" />
                </StackPanel>
              </StackPanel>
              <Border Height="1" Background="#1E293B" />
            <WrapPanel DataContext="{Binding Item}" HorizontalAlignment="Left">
              <Border Classes="pill" Background="#1A22C55E" BorderBrush="#22C55E" IsVisible="{Binding IsPinned}" Margin="0,0,8,6">
                <TextBlock Text="{Binding PinText}" FontSize="12" Foreground="#4ADE80" TextWrapping="Wrap" />
              </Border>
              <Border Classes="pill" Background="#1A2DD4BF" BorderBrush="#2DD4BF" IsVisible="{Binding IsSoftPin}" Margin="0,0,8,6">
                <TextBlock Text="worth a glance" FontSize="12" Foreground="#5EEAD4" />
              </Border>
              <Border Classes="pill" Background="#1AF59E0B" BorderBrush="#F59E0B" IsVisible="{Binding IsFlagged}" Margin="0,0,8,6">
                <TextBlock Text="{Binding FlagReason, StringFormat='⚠ Needs a look: {0}'}" FontSize="12" Foreground="#FBBF24" TextWrapping="Wrap" MaxWidth="280" />
              </Border>
              <Border Classes="pill" Background="#1AF59E0B" BorderBrush="#F59E0B" IsVisible="{Binding FinishUnsure}" Margin="0,0,8,6">
                <TextBlock Text="{Binding FinishNote, StringFormat='✨ Finish: {0}'}" FontSize="12" Foreground="#FBBF24" TextWrapping="Wrap" MaxWidth="280" />
              </Border>
            </WrapPanel>
            <TextBlock DataContext="{Binding Item}" Classes="teal" FontSize="12" Text="{Binding DetailNote, StringFormat='🔎 {0}'}" TextAlignment="Left"
                       IsVisible="{Binding DetailNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
            <TextBlock DataContext="{Binding Item}" Classes="muted" FontSize="11" Text="{Binding ReadText}" TextWrapping="Wrap" TextAlignment="Left" />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- The two cards, side by side with a fixed gap, sized to the window in code (Resize) so both line up and
           the captions sit right under the pictures at any window size -->
      <Panel Name="CardsHost" Grid.Row="1" Grid.Column="1" Margin="24,14">
        <Grid ColumnDefinitions="Auto,120,Auto" RowDefinitions="Auto,Auto,Auto" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Classes="muted" FontSize="12" FontWeight="SemiBold" LetterSpacing="1"
                     Text="YOUR PHOTO" HorizontalAlignment="Center" Margin="0,0,0,6" />
          <TextBlock Grid.Column="2" Classes="teal" FontSize="12" FontWeight="SemiBold" LetterSpacing="1"
                     Text="REFERENCE IMAGE" HorizontalAlignment="Center" Margin="0,0,0,6" />

          <Panel Grid.Row="1" Name="LeftPane" Background="Transparent">
            <Image Name="LeftImg" Source="{Binding LeftShown}" Stretch="Uniform" />
            <Canvas IsHitTestVisible="False">
              <Border Name="LeftLens" Width="360" Height="360" ClipToBounds="True" IsVisible="False" CornerRadius="12"
                      BorderBrush="{StaticResource TealBrush}" BorderThickness="2" Background="#000" BoxShadow="0 6 18 0 #90000000">
                <Canvas><Image Name="LeftLensImg" Source="{Binding LeftShown}" Stretch="Fill" /></Canvas>
              </Border>
            </Canvas>
          </Panel>
          <Panel Grid.Row="1" Grid.Column="2" Name="RightPane" Background="Transparent">
            <Image Name="RightImg" Source="{Binding RightShown}" Stretch="Uniform" />
            <Canvas IsHitTestVisible="False">
              <Border Name="RightLens" Width="360" Height="360" ClipToBounds="True" IsVisible="False" CornerRadius="12"
                      BorderBrush="{StaticResource TealBrush}" BorderThickness="2" Background="#000" BoxShadow="0 6 18 0 #90000000">
                <Canvas><Image Name="RightLensImg" Source="{Binding RightShown}" Stretch="Fill" /></Canvas>
              </Border>
            </Canvas>
          </Panel>

          <!-- Under your photo: scan number (top layout) and the Finish -->
          <StackPanel Grid.Row="2" Name="LeftCaption" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" Spacing="4">
            <TextBlock Text="{Binding PhotoName}" FontSize="14" Classes="muted" HorizontalAlignment="Center" IsVisible="{Binding IsTopLayout}" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" DataContext="{Binding Item}">
              <TextBlock Text="Finish:" VerticalAlignment="Center" FontWeight="SemiBold" />
              <ComboBox ItemsSource="{Binding FinishOptions}" SelectedItem="{Binding SelectedFinish}"
                        IsEnabled="{Binding HasFinishChoice}" MinWidth="150" />
            </StackPanel>
            <TextBlock DataContext="{Binding Item}" Text="{Binding FinishNote}" FontSize="12" Classes="muted"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
          <!-- Under the reference image: which printing this is -->
          <StackPanel Grid.Row="2" Grid.Column="2" Name="RightCaption" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" Spacing="2">
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Subtitle}" FontSize="16" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Classes="gold" Text="{Binding Extra}" FontSize="15" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            <Border Classes="pill" HorizontalAlignment="Center" Margin="0,4,0,0" Background="{Binding RarityBackground}" BorderBrush="{Binding RarityBorder}" BorderThickness="1" IsVisible="{Binding HasRarity}">
              <TextBlock Text="{Binding Rarity}" FontSize="13" FontWeight="Bold" Foreground="{Binding RarityForeground}" />
            </Border>
          </StackPanel>
        </Grid>
      </Panel>

      <!-- Buttons along the bottom ("Tags on top" layout) -->
      <StackPanel Grid.Row="2" Grid.Column="1" Spacing="10" HorizontalAlignment="Center" IsVisible="{Binding IsTopLayout}">
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
          <Button Content="◀ Last card" Command="{Binding LastCardCommand}" IsEnabled="{Binding CanGoBack}"
                  ToolTip.Tip="Back to the card before this one, to fix a mis-click (Backspace)" />
          <Button Content="{Binding ZoomLabel}" Command="{Binding ToggleZoomCommand}"
                  ToolTip.Tip="Show just the bottom of both cards (Z). Hovering over a card magnifies it; M turns the magnifier on/off." />
          <Button Content="◀ Previous option" Command="{Binding PreviousCommand}" />
          <Button Classes="accent" Content="✓ This is the one" Command="{Binding PickThisCommand}" Padding="22,8"
                  ToolTip.Tip="Marks this printing and moves to the next card (Enter)" />
          <Button Content="Next option ▶" Command="{Binding NextCommand}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
          <Button Content="≈ Right card, printing not listed" Command="{Binding NameOnlyCommand}" FontSize="12" />
          <Button Content="✗ Wrong card" Command="{Binding WrongCardCommand}" FontSize="12" />
          <Button Content="{Binding FlipLabel}" Command="{Binding FlipCommand}" FontSize="12" IsVisible="{Binding CanFlip}"
                  ToolTip.Tip="Card upside down? Identify it again turned around (F)" />
          <Button Content="Skip card ⏭" Command="{Binding SkipCommand}" FontSize="12"
                  ToolTip.Tip="Leave this one for later and look at the next card (S)" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </Grid>
  </Panel>
</UserControl>
