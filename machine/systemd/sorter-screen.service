[Unit]
Description=Card sorter touchscreen (Chromium kiosk on the Touch Display)
After=card-sorter.service systemd-user-sessions.service
Wants=card-sorter.service
Conflicts=getty@tty1.service

[Service]
User=pi
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
UtmpIdentifier=tty1
UtmpMode=user
ExecStartPre=/usr/bin/python3 /home/pi/mtg-card-scanner/machine/systemd/wait-for-app.py
ExecStart=/usr/bin/cage -d -- /home/pi/mtg-card-scanner/machine/systemd/kiosk.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
