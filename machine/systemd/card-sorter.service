[Unit]
Description=Card sorter (machine control + touchscreen app on port 8080)
After=network-online.target klipper.service moonraker.service
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/mtg-card-scanner/machine/sorter
ExecStart=/usr/bin/python3 app.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
